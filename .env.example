# Copier en .env (jamais commité). En GitHub Actions : Settings > Secrets and variables > Actions.

# API Claude (scoring). Sans clé, un score heuristique est utilisé.
ANTHROPIC_API_KEY=

# francetravail.io > Mes applications > API « Offres d'emploi v2 »
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Zoho Mail : mot de passe d'application (IMAP pour les alertes Malt, SMTP pour le digest)
IMAP_USER=contact@lienos.fr
IMAP_PASSWORD=
SMTP_USER=contact@lienos.fr
SMTP_PASSWORD=

# Optionnel : collecte Free-Work via Apify
APIFY_TOKEN=
